rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /risks/{riskId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /mitigations/{mitigationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /units/{unitId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /sasaran_strategis/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /sasaran_program/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /sasaran_kegiatan/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /mr_konteks/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /mr_identifikasi/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /audit_submissions/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /activity_logs/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /katalog_peraturan/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /dokumen_chunks/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /chat_messages/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /user_preferences/{userId} {
      allow read, write: if isAuthenticated();
    }
  }
}
